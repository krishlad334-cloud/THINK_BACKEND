# Server
NODE_ENV=development
PORT=5000

# MongoDB (local default or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/overthink

# JWT Authentication
JWT_SECRET=replace_with_a_strong_random_64_char_secret_key
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CLIENT_URL=https://thinkhere.vercel.app,http://localhost:5500,http://127.0.0.1:5500

# Email Notifications (Nodemailer SMTP - optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=OverThink <no-reply@overthink.app>
